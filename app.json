{
  "expo": {
    "name": "AI Limits Tracker",
    "slug": "ai-limits-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ailimits",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f2f1ed",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ailimits.tracker"
    },
    "android": {
      "package": "com.ailimits.tracker",
      "adaptiveIcon": {
        "backgroundColor": "#f2f1ed",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
