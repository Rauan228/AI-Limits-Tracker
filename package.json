{
  "name": "ai-limits-tracker",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "tsx tests/run_tests.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit && tsc -p server --noEmit && tsc -p web --noEmit && tsc -p extension --noEmit",
    "build": "node scripts/build.mjs",
    "build:server": "node scripts/build.mjs server",
    "build:web": "node scripts/build.mjs web",
    "build:extension": "node scripts/build.mjs extension",
    "server": "node server/dist/server.mjs",
    "server:dev": "node --watch server/dist/server.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "expo": "~57.0.27",
    "expo-background-fetch": "~57.0.21",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "lucide-react-native": "^0.475.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "private": true
}
